FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

# Retry npm install up to 3 times with increased timeout
RUN npm install --registry https://registry.npmjs.org --fetch-retry-mintimeout 20000 --fetch-retry-maxtimeout 120000 --fetch-retries 5 || \
    npm install --registry https://registry.npmjs.org --fetch-retry-mintimeout 20000 --fetch-retry-maxtimeout 120000 --fetch-retries 5 || \
    npm install --registry https://registry.npmjs.org --fetch-retry-mintimeout 20000 --fetch-retry-maxtimeout 120000 --fetch-retries 5

COPY . .

RUN npm run build

EXPOSE 4173

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]